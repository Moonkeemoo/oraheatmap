# Database
DATABASE_URL=postgres://postgres:changeme@localhost:5432/whale_heatmap

# Polymarket endpoints
RTDS_WS_URL=wss://ws-live-data.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_URL=https://clob.polymarket.com

# WebSocket tuning (from oralab v2 production)
WS_PING_INTERVAL_MS=20000
WS_PING_JITTER_MAX_MS=5000
WS_HEARTBEAT_THRESHOLD_MS=30000
WS_DATA_SILENCE_THRESHOLD_MS=45000
WS_DEAD_BOOK_BID_THRESHOLD=0.02

# Cache TTLs
GAMMA_CACHE_TTL_MS=30000
BOOK_CACHE_TTL_MS=500

# Server
PORT=3001
HOST=0.0.0.0

# Polymarket signing (post-MVP — only needed if executing trades)
POLY_PRIVATE_KEY=
POLY_WALLET_ADDRESS=

# CLOB API auth (post-MVP)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Telegram alerts (v1.3+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# RPC (for on-chain enrichment if needed)
VALIDATIONCLOUD_RPC_KEY=

# ─── Auth (Auth.js v5) ───────────────────────────────────────────────────────
# Shared HS256 JWT secret. Web (Next.js) signs the cookie; API (Elysia)
# verifies it with the same key. Generate with: `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of the web app (Auth.js needs it for OAuth callback construction).
# Local dev: http://localhost:3000   Prod: https://oralab.xyz
AUTH_URL=
# Cookie domain — apex so both `oralab.xyz/` (web) and `oralab.xyz/api/*` (API)
# read the same cookie. Leave blank in dev (defaults to current host).
AUTH_COOKIE_DOMAIN=

# Optional providers — each block can be left empty. The Login modal
# hides any provider whose env keys are missing.
RESEND_API_KEY=
EMAIL_FROM=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TG_LOGIN_BOT_TOKEN=
NEXT_PUBLIC_TG_LOGIN_BOT_USERNAME=
