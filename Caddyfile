# Production Caddyfile — installed at /etc/caddy/Caddyfile on the host VPS.
# Reverse-proxies oralab.xyz to two long-lived processes managed by systemd:
#   - Next.js web (oraheatmap-web.service) on 127.0.0.1:3000
#   - Elysia API + SSE (oraheatmap-api.service) on 127.0.0.1:3001
#
# Order matters in Caddy — more-specific `handle` blocks evaluate first, so
# the Next.js-owned API prefixes (auth + account) MUST come before the
# generic /api/* catch-all that goes to Elysia.
#
# Replace `oralab.xyz` with your own domain if you fork. Email is used by
# Let's Encrypt for cert-renewal notices.

{
  email admin@oralab.xyz
}

oralab.xyz, www.oralab.xyz {
  encode zstd gzip

  # Auth.js routes live in the Next.js app — sign-in / callback / providers.
  handle /api/auth/* {
    reverse_proxy 127.0.0.1:3000
  }

  # Account-management routes live in Next.js too — link / unlink / export
  # / delete. Without this block they'd fall into the Elysia catch-all
  # below and 404 (Elysia never registers them).
  handle /api/account/* {
    reverse_proxy 127.0.0.1:3000
  }

  # Everything else under /api/* → Elysia (heatmap, whale, stream, me, …).
  handle /api/* {
    reverse_proxy 127.0.0.1:3001 {
      # SSE: don't buffer / don't time out long-lived /api/stream connections.
      flush_interval -1
      transport http {
        read_timeout 24h
      }
    }
  }

  # Everything else → Next.js dashboard / landing / legal pages.
  handle {
    reverse_proxy 127.0.0.1:3000
  }
}
